# ==============================================================================
# ABAST GP V6 — P17: PLANTILLA DE VARIABLES DE ENTORNO PARA DESPLIEGUE LAN (HTTPS)
# ==============================================================================
# Copiar este archivo a '.env.lan' y completar las contraseñas seguras antes del despliegue.
# Todas las claves deben ser secretas y no compartidas.

# 1. Base de Datos PostgreSQL 15 Aislada (Red Interna LAN)
POSTGRES_USER=abst_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_PG15_P17
POSTGRES_DB=abst_gp_lan

# 2. Redis 7 Aislado (Red Interna LAN)
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_REDIS_P17

# 3. Llaves de Aplicacion y Criptografia (32 bytes / 64 hex chars)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_POR_SECRET_KEY_SEGURO_DE_PRODUCCION_P17
MFA_ENCRYPTION_KEY=01234567890123456789012345678901
BACKUP_ENCRYPTION_KEY=01234567890123456789012345678901
BACKUP_SIGNING_KEY=01234567890123456789012345678901
VALIDATION_API_KEY=CAMBIAR_POR_VALIDATION_API_KEY_64_HEX

# 4. Enlace de Red LAN Institucional
# IP de la interfaz física de red donde el reverse proxy escuchará en el puerto 443
# En este host (LUISGUIVIN): 192.168.100.7 (Wi-Fi) o 192.168.2.18 (Ethernet)
LAN_BIND_IP=192.168.100.7
SERVER_NAME=192.168.100.7

# 5. Canales de Notificacion Operativa (Opcional)
ALERT_CHANNEL=webhook
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
