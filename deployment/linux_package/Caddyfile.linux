# Caddyfile para Servidor Linux Dedicado ABST-GP V6 (P19)
# Escucha exclusivamente en HTTPS 443 con TLS y HTTP/80 cerrado

{
    admin off
    auto_https disable_redirects
    default_sni {$SERVER_NAME:localhost}
}

https://{$SERVER_NAME:localhost}:443 {
    tls internal

    # Cabeceras de seguridad HTTP
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none';"
    }

    # API Backend Reverse Proxy
    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /auth/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /admin/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /cases/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    handle /validation/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }

    # Bloqueo de Swagger / OpenAPI, ReDoc y Métricas desde la LAN externa
    handle /docs* {
        respond "Acceso no autorizado desde la red externa" 403
    }
    handle /redoc* {
        respond "Acceso no autorizado desde la red externa" 403
    }
    handle /openapi.json {
        respond "Acceso no autorizado desde la red externa" 403
    }
    handle /metrics* {
        respond "Acceso no autorizado desde la red externa" 403
    }

    # Frontend Single Page Application
    handle {
        reverse_proxy web:80
    }
}
