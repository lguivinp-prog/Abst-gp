# =========================================================================
# ABST-GP V6 — CONFIGURACION DE ENTORNO SERVIDOR LINUX DEDICADO (P19)
# =========================================================================
# INSTRUCCIONES OBLIGATORIAS DE SEGURIDAD (FASE 1 RESTAURACION / FASE 2 ROTACION):
# 
# [FASE 1 - RESTAURACION]:
# 1. Copiar este archivo a '.env.production'.
# 2. Asignar permisos estrictos: chmod 600 .env.production.
# 3. EXTRAER DE LA CUSTODIA SEGURA (D:\BACKUPS_PROYECTOS\ABAST_GP_P19_MIGRATION\custody\)
#    las tres claves criptograficas de origen:
#    - BACKUP_ENCRYPTION_KEY  (Requerida para descifrar el respaldo P19)
#    - BACKUP_SIGNING_KEY     (Requerida para verificar la firma HMAC del manifiesto)
#    - MFA_ENCRYPTION_KEY     (Requerida para descifrar los secretos TOTP de usuarios existentes)
#    Prohibido cambiarlas antes de restaurar, o los datos quedaran inaccesibles.
#
# [FASE 2 - ROTACION CONTROLADA POST-VERIFICACION]:
# 1. Una vez restaurado y verificado el sistema en el servidor Linux, se puede rotar:
#    - SECRET_KEY (Invalida sesiones JWT anteriores, obligando a reautenticacion segura)
#    - POSTGRES_PASSWORD / REDIS_PASSWORD (Rotacion de contraseñas de infraestructura)
#    - VALIDATION_API_KEY
# 2. Las claves de backup se rotan generando un nuevo respaldo firmado con la nueva clave.
# =========================================================================

COMPOSE_PROJECT_NAME=abst_production
APP_ENV=lan

# RED Y ENDPOINT INSTITUCIONAL
# Asigne la IP estatica de la interfaz cableada RJ45 del servidor Linux (ej. 192.168.2.50)
LAN_BIND_IP=192.168.2.50
# Nombre FQDN institucional o IP del servidor (ej. abastgp.institucion.gob.pe)
SERVER_NAME=192.168.2.50

# BASE DE DATOS POSTGRESQL 15 (Interna, sin puertos al host)
POSTGRES_USER=abst_prod_admin
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD_32_CHARS
POSTGRES_DB=abst_gp_lan

# CACHE Y COLAS REDIS 7 (Interno, sin puertos al host)
REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD_32_CHARS

# JWT Y SEGURIDAD DE SESION
SECRET_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET_KEY

# CLAVES CRIPTOGRAFICAS (Fase 1: OBLIGATORIAMENTE LAS DE ORIGEN EN CUSTODIA)
MFA_ENCRYPTION_KEY=PASTE_ORIGIN_MFA_ENCRYPTION_KEY_FROM_CUSTODY
BACKUP_ENCRYPTION_KEY=PASTE_ORIGIN_BACKUP_ENCRYPTION_KEY_FROM_CUSTODY
BACKUP_SIGNING_KEY=PASTE_ORIGIN_BACKUP_SIGNING_KEY_FROM_CUSTODY

# API KEYS Y CONTROL DE ACCESO
VALIDATION_API_KEY=REPLACE_WITH_64_HEX_CHAR_KEY

# CANAL DE ALERTAS DE SEGURIDAD
ALERT_CHANNEL=webhook
ALERT_WEBHOOK_URL=http://127.0.0.1:8000/api/v6/health
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
